{
  "paths": {
    "input_dir": "videos/input/",
    "output_dir": "videos/output/",
    "processed_dir": "videos/processed/",
    "supported_formats": [
      ".mp4",
      ".mkv",
      ".mov"
    ],
    "cache_dir": "videos/cache"
  },
  "whisper": {
    "model": "large-v3",
    "language": "es",
    "device": "auto",
    "compute_type": "float16"
  },
  "viral_detection": {
    "min_clip_duration": 10,
    "max_clip_duration": 60,
    "pre_buffer_seconds": 3,
    "post_buffer_seconds": 2,
    "top_n_clips": 999,
    "score_weights": {
      "audio_peak": 0.45,
      "speech_speed": 0.35,
      "keywords": 0.2,
      "scene_change": 0.0
    },
    "viral_keywords": [
      "increíble",
      "no puede ser",
      "qué pasa",
      "vamos",
      "brutal",
      "bestia",
      "locura",
      "boom",
      "dios mío",
      "wtf",
      "insano",
      "épico"
    ],
    "skip_intro_sec": 28,
    "skip_outro_sec": 28,
    "min_fragment_dur": 1.5
  },
  "face_detection": {
    "transition_buffer_frames": 30,
    "smooth_tracking": true,
    "border_color_hsv_lower": [
      125,
      50,
      50
    ],
    "border_color_hsv_upper": [
      165,
      255,
      255
    ],
    "border_min_ratio": 0.7,
    "border_px": 8,
    "require_face": true,
    "face_scale_factor": 1.3,
    "face_min_neighbors": 9,
    "face_min_size_ratio": 0.2
  },
  "censorship": {
    "mode": "tiktok",
    "custom_words": [],
    "beep_frequency_hz": 1000,
    "profiles": {
      "tiktok": {
        "strictness": "high"
      },
      "youtube": {
        "strictness": "medium"
      },
      "instagram": {
        "strictness": "high"
      },
      "twitch": {
        "strictness": "low"
      }
    }
  },
  "subtitles": {
    "font_size": 72,
    "outline_width": 4,
    "position_y_ratio": 0.82,
    "max_line_width": 20,
    "max_line_count": 1,
    "font_name": "Showcard Gothic",
    "manual_offset_sec": 0.4
  },
  "output": {
    "resolution_w": 1080,
    "resolution_h": 1920,
    "fps": 60,
    "audio_codec": "aac",
    "naming_pattern": "{source_name}_clip_{n}.mp4"
  },
  "gpu": {
    "force_cpu": false,
    "ffmpeg_encoder_override": null,
    "torch_device_override": null
  },
  "watch_mode": {
    "enabled": false,
    "poll_interval_seconds": 10,
    "move_processed": true
  },
  "layout": {
    "webcam_w_ratio": 0.137,
    "webcam_h_ratio": 0.331,
    "webcam_x_offset": 22,
    "gameplay_zoom": 1.5,
    "webcam_y_center_ratio": 0.5,
    "stats_skip_ratio": 0,
    "fullscreen_zoom": 1.5,
    "min_segment_sec": 0.5,
    "webcam_overlay_w_ratio": 0.485,
    "webcam_overlay_y_ratio": 0.01,
    "webcam_name_h_ratio": 0.055,
    "webcam_name_color_bgr": [
      255,
      50,
      255
    ],
    "gameplay_x_offset": -200,
    "name_top_h_ratio": 0.1,
    "neon_sweep_speed": 0.6,
    "gameplay_x_offset_driving": -150,
    "driving_hud_min_components": 6,
    "driving_hud_white_thresh": 200,
    "driving_hud_min_area": 20,
    "driving_hud_max_area": 800
  },
  "claude": {
    "api_key": "",
    "content_type": "gaming",
    "streamer_name": "AngelSine",
    "game_name": "GTA V"
  },
  "gemini": {
    "api_key": "AIzaSyCM-jttJGVT_NceOpqqBngVx7GDrk_RKtg",
    "model": "gemini-3.1-flash-lite-preview"
  }
}